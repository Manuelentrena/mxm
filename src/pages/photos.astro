---
import { getCollection } from "astro:content";
import PhotosGrid from "../components/PhotosGrid.astro";
import PhotosHero from "../components/PhotosHero.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";

const timelineEntries = (await getCollection("timeline")).sort(
  (a, b) => a.data.order - b.data.order,
);

// Cada imagen forma una celda independiente del muro de fotos
const photos = timelineEntries.flatMap((entry) =>
  entry.data.images.map((src) => ({
    image: src,
    alt: entry.data.alt,
    date: entry.data.date,
    title: entry.data.title,
  }))
);
---

<BaseLayout title="Fotos | M♥M" description="Momentos fotográficos de nuestro camino juntos.">
  <main class="page-shell" aria-label="Our Story photos page">
    <section class="artboard photos-page">
      <div class="paper-noise"></div>
      <SiteHeader active="photos" />
      <PhotosHero />
      <PhotosGrid photos={photos} />
      <SiteFooter showHomeLink showPhotosLink={false} />
    </section>
  </main>
</BaseLayout>
