---
import { formatDateLabel, siteConfig } from "../site.config";

interface Props {
  showHomeLink?: boolean;
  showPhotosLink?: boolean;
}

const { showHomeLink = false, showPhotosLink = true } = Astro.props;
const relationshipStart = formatDateLabel();
---

<footer id="guestbook" class="footer-note">
  <div class="footer-main">
    <div class="footer-brand">
      <h2><a href="https://github.com/huey1in/OurStory" target="_blank" rel="noopener noreferrer" class="footer-repo-link">M♥M</a></h2>
      <p>Gracias por aparecer en mi vida.</p>
    </div>

    <div class="footer-links" aria-label="Navegación del pie de página">
      {showHomeLink && <a href={import.meta.env.BASE_URL}>Inicio</a>}
      {showPhotosLink && <a href={`${import.meta.env.BASE_URL}photos`}>Fotos</a>}
    </div>
  </div>

  <div class="footer-bottom">
    <p>{relationshipStart} Guardando cada instante con cariño</p>
    <p>
    {siteConfig.copyright.text}
    <a href={siteConfig.copyright.linkUrl} target="_blank" rel="noopener noreferrer">
      {siteConfig.copyright.linkText}
    </a>
    {siteConfig.copyright.suffix}
  </p>
  </div>
</footer>
