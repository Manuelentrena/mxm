---
interface Props {
  active: "home" | "photos";
}

const { active } = Astro.props;

const navItems = [
  { href: import.meta.env.BASE_URL, label: "Inicio", key: "home" },
  { href: `${import.meta.env.BASE_URL}photos`, label: "Fotos", key: "photos" },
] as const;
---

<header class="topbar">
  <a class="brand brand-link" href={import.meta.env.BASE_URL} aria-label="M♥M Inicio">
    <span class="brand-text">M♥M</span>
  </a>
  <button class="menu-toggle" type="button" aria-label="Abrir menú de navegación" aria-expanded="false" aria-controls="site-nav">
    <span></span>
    <span></span>
    <span></span>
  </button>
  <nav id="site-nav" class="nav" aria-label="Navegación de páginas">
    {navItems.map((item) => (
      <a class:list={["nav-link", `nav-${item.key}`, { active: active === item.key }]} href={item.href}>
        <span class="nav-label">{item.label}</span>
      </a>
    ))}
  </nav>
</header>

<script>
  if (!document.documentElement.dataset.mobileMenuReady) {
    document.documentElement.dataset.mobileMenuReady = "true";

    document.addEventListener("click", (event) => {
      const menuButton = event.target instanceof Element ? event.target.closest(".menu-toggle") : null;

      if (!(menuButton instanceof HTMLButtonElement)) {
        return;
      }

      const siteNav = document.querySelector("#site-nav");

      if (!(siteNav instanceof HTMLElement)) {
        return;
      }

      const nextExpanded = menuButton.getAttribute("aria-expanded") !== "true";

      menuButton.setAttribute("aria-expanded", String(nextExpanded));
      menuButton.setAttribute("aria-label", nextExpanded ? "Cerrar menú de navegación" : "Abrir menú de navegación");
      siteNav.classList.toggle("is-open", nextExpanded);
    });
  }

  document.addEventListener("astro:before-swap", () => {
    const menuButton = document.querySelector(".menu-toggle");
    const siteNav = document.querySelector("#site-nav");

    if (!(menuButton instanceof HTMLButtonElement) || !(siteNav instanceof HTMLElement)) {
      return;
    }

    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "Abrir menú de navegación");
    siteNav.classList.remove("is-open");
  });
</script>
