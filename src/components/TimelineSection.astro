---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { cloudinaryUrl } from "../site.config";

interface TimelineCard {
  entry: {
    data: {
      side: "left" | "right";
      tilt: string;
      images: string[];
      alt: string;
      date: string;
      title: string;
    };
  };
  Content: AstroComponentFactory;
}

interface Props {
  timelineCards: TimelineCard[];
}

const { timelineCards } = Astro.props;

const STACK_LIMIT = 3;
const THUMB_WIDTHS = [240, 480];

function fullSrc(src: string) {
  return cloudinaryUrl(src, "w_1600,f_auto,q_auto");
}
---

<section id="timeline" class="timeline-section">
  <h2>Línea de tiempo<span>♡</span></h2>
  <div class="timeline-line" aria-hidden="true">
    <span class="node n1"></span>
    <span class="node n2"></span>
    <span class="node n3"></span>
  </div>

  {timelineCards.map(({ entry, Content }, index) => {
    const { images, alt, side, tilt, date, title } = entry.data;
    const stackImgs = images.slice(0, STACK_LIMIT);
    const hasStack = images.length > 1;

    const renderThumb = (src: string, thumbAlt: string) => {
      const srcset = THUMB_WIDTHS.map(
        (w) => `${cloudinaryUrl(src, `w_${w},f_auto,q_auto`)} ${w}w`,
      ).join(", ");
      return (
        <img
          src={cloudinaryUrl(src, "w_240,f_auto,q_auto")}
          srcset={srcset}
          sizes="240px"
          alt={thumbAlt}
          decoding="async"
          loading="lazy"
        />
      );
    };

    const photoBlock = (tapeSide: "left" | "right") => hasStack ? (
      <div
        class={`photo-stack ${tilt}`}
        data-lightbox
        data-images={JSON.stringify(images.map(fullSrc))}
        data-alt={alt}
        data-date={date}
        data-title={title}
        role="button"
        tabindex="0"
        aria-label={`Ver ${images.length} fotos de "${title}"`}
      >
        {stackImgs.map((src, i) => (
          <figure
            class={`polaroid small-photo stack-item stack-${i + 1}`}
            aria-hidden={i > 0 ? "true" : undefined}
          >
            {i === 0 && <span class={`tape tape-corner-${tapeSide}`}></span>}
            <span class="thumb-spinner" aria-hidden="true"></span>
            {renderThumb(src, i === 0 ? alt : "")}
            <span class="stack-count" aria-hidden="true">{images.length} fotos</span>
          </figure>
        ))}

      </div>
    ) : (
      <figure
        class={`polaroid small-photo ${tilt}`}
        data-lightbox
        data-images={JSON.stringify(images.map(fullSrc))}
        data-alt={alt}
        data-date={date}
        data-title={title}
        role="button"
        tabindex="0"
        aria-label={`Ver foto de "${title}"`}
      >
        <span class={`tape tape-corner-${tapeSide}`}></span>
        <span class="thumb-spinner" aria-hidden="true"></span>
        {renderThumb(stackImgs[0], alt)}
        <span class="stack-count" aria-hidden="true">1 foto</span>
      </figure>
    );

    return (
      <article class={`event event-${side} event-${index + 1}`}>
        {side === "left" ? (
          <>
            {photoBlock("left")}
            <div class="memory-card">
              <time>{date} ♡</time>
              <h3>{title}</h3>
              <Content />
            </div>
          </>
        ) : (
          <>
            <div class="memory-card">
              <time>{date} ♡</time>
              <h3>{title}</h3>
              <Content />
            </div>
            {photoBlock("right")}
          </>
        )}
      </article>
    );
  })}

  <p class="future">
    Cada día del futuro,<br />
    quiero pasarlo contigo.<span>♡</span>
  </p>
</section>

{/* ── Overlay del lightbox (uno solo para todo el sitio, reutilizado) ─────────────────────────────────────── */}
<div id="lightbox" class="lightbox" hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Ver foto">
  <button class="lb-close" data-lb-close aria-label="Cerrar">&times;</button>
  <button class="lb-nav lb-prev" data-lb-prev aria-label="Anterior">&#8249;</button>
  <figure class="lb-frame">
    <span class="lb-spinner" data-lb-spinner aria-hidden="true"></span>
    <img class="lb-img" data-lb-img src="" alt="" />
    <figcaption class="lb-caption">
      <time class="lb-date" data-lb-date></time>
      <span class="lb-title" data-lb-title></span>
      <span class="lb-counter" data-lb-counter></span>
    </figcaption>
  </figure>
  <button class="lb-nav lb-next" data-lb-next aria-label="Siguiente">&#8250;</button>
</div>

<script>
  function initLightbox() {
    const lb = document.getElementById("lightbox");
    if (!lb || lb.dataset.bound) return;
    lb.dataset.bound = "1";

    const imgEl = lb.querySelector<HTMLImageElement>("[data-lb-img]")!;
    const counterEl = lb.querySelector<HTMLElement>("[data-lb-counter]")!;
    const dateEl = lb.querySelector<HTMLElement>("[data-lb-date]")!;
    const titleEl = lb.querySelector<HTMLElement>("[data-lb-title]")!;
    const btnPrev = lb.querySelector<HTMLElement>("[data-lb-prev]")!;
    const btnNext = lb.querySelector<HTMLElement>("[data-lb-next]")!;
    const btnClose = lb.querySelector<HTMLElement>("[data-lb-close]")!;
    const stage = lb.querySelector<HTMLElement>(".lb-frame")!;

    let images: string[] = [];
    let alt = "";
    let idx = 0;
    let lastTrigger: HTMLElement | null = null;

    // Oculta el indicador de carga cuando la imagen termina de cargar o falla (un hit de caché también dispara load)
    imgEl.addEventListener("load", () => stage.classList.remove("is-loading"));
    imgEl.addEventListener("error", () => stage.classList.remove("is-loading"));

    const render = () => {
      stage.classList.add("is-loading");
      imgEl.src = images[idx];
      // Si ya está en caché (complete es true de inmediato), oculta el indicador directamente para evitar un parpadeo
      if (imgEl.complete && imgEl.naturalWidth > 0) {
        stage.classList.remove("is-loading");
      }
      imgEl.alt = images.length > 1 ? `${alt} (${idx + 1})` : alt;
      counterEl.textContent =
        images.length > 1 ? `${idx + 1} / ${images.length}` : "";
      const multi = images.length > 1;
      btnPrev.hidden = !multi;
      btnNext.hidden = !multi;
      // Precarga las imágenes vecinas
      [idx + 1, idx - 1].forEach((n) => {
        const src = images[(n + images.length) % images.length];
        if (src) new Image().src = src;
      });
    };

    let savedScrollY = 0;

    const open = (trigger: HTMLElement) => {
      images = JSON.parse(trigger.dataset.images ?? "[]");
      alt = trigger.dataset.alt ?? "";
      dateEl.textContent = trigger.dataset.date ?? "";
      titleEl.textContent = trigger.dataset.title ?? "";
      idx = 0;
      if (!images.length) return;
      lastTrigger = trigger;
      render();
      lb.hidden = false;
      lb.setAttribute("aria-hidden", "false");
      // Fija el body para evitar que el scroll táctil móvil atraviese el overlay (guarda y bloquea la posición actual)
      savedScrollY = window.scrollY;
      document.body.style.top = `-${savedScrollY}px`;
      document.documentElement.classList.add("has-photo-lightbox");
      requestAnimationFrame(() => lb.classList.add("open"));
      btnClose.focus();
    };

    const close = () => {
      lb.classList.remove("open");
      document.documentElement.classList.remove("has-photo-lightbox");
      document.body.style.top = "";
      // Desactiva temporalmente scroll-behavior:smooth en html, si no al restaurar el scroll animaría desde arriba con posición incorrecta
      const html = document.documentElement;
      const prevBehavior = html.style.scrollBehavior;
      html.style.scrollBehavior = "auto";
      window.scrollTo(0, savedScrollY);
      html.style.scrollBehavior = prevBehavior;
      lb.setAttribute("aria-hidden", "true");
      const done = () => {
        lb.hidden = true;
        lb.removeEventListener("transitionend", done);
      };
      lb.addEventListener("transitionend", done);
      lastTrigger?.focus();
    };

    const go = (delta: number) => {
      idx = (idx + delta + images.length) % images.length;
      render();
    };

    // Enlaza todos los disparadores
    document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((el) => {
      if (el.dataset.lbBound) return;
      el.dataset.lbBound = "1";
      el.addEventListener("click", () => open(el));
      el.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          open(el);
        }
      });
    });

    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", (e) => { e.stopPropagation(); go(-1); });
    btnNext.addEventListener("click", (e) => { e.stopPropagation(); go(1); });

    // Miniaturas de la línea de tiempo: muestra el indicador hasta que termine de cargar
    document.querySelectorAll<HTMLImageElement>(
      ".small-photo img",
    ).forEach((img) => {
      const fig = img.closest(".polaroid");
      if (!fig) return;
      const done = () => fig.classList.add("img-loaded");
      if (img.complete && img.naturalWidth > 0) done();
      else {
        img.addEventListener("load", done, { once: true });
        img.addEventListener("error", done, { once: true });
      }
    });

    // Cierra al hacer clic en el espacio vacío del overlay
    lb.addEventListener("click", (e) => {
      if (e.target === lb) close();
    });

    document.addEventListener("keydown", (e) => {
      if (lb.hidden) return;
      if (e.key === "Escape") close();
      else if (e.key === "ArrowRight") go(1);
      else if (e.key === "ArrowLeft") go(-1);
    });

    // Deslizamiento horizontal en móvil
    let touchX = 0;
    lb.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    lb.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - touchX;
      if (Math.abs(dx) > 45) go(dx < 0 ? 1 : -1);
    }, { passive: true });
  }

  initLightbox();
  document.addEventListener("astro:page-load", initLightbox);
</script>
