---
import { cloudinaryUrl } from "../site.config";

interface Photo {
  image: string;
  alt: string;
  date: string;
  title: string;
}

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

const GRID_WIDTHS = [300, 450, 700, 1000];
const GRID_SIZES = "(max-width: 640px) 100vw, (max-width: 920px) 50vw, 33vw";
---

<section class="photos-wall" aria-label="Muro de fotos">
  {photos.map((photo, index) => (
    <article class={`photo-tile photo-tile-${(index % 4) + 1}`}>
      <figure>
        <button
          class="photo-open"
          type="button"
          aria-label={`Ampliar: ${photo.title}`}
          data-photo-open
          data-photo-src={cloudinaryUrl(photo.image, "w_1600,f_auto,q_auto")}
          data-photo-alt={photo.alt}
          data-photo-date={photo.date}
          data-photo-title={photo.title}
        >
          <img
            src={cloudinaryUrl(photo.image, "w_700,f_auto,q_auto")}
            srcset={GRID_WIDTHS.map(
              (w) => `${cloudinaryUrl(photo.image, `w_${w},f_auto,q_auto`)} ${w}w`,
            ).join(", ")}
            sizes={GRID_SIZES}
            alt={photo.alt}
            decoding="async"
            loading={index < 6 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : undefined}
          />
        </button>
      </figure>
      <div>
        <time>{photo.date}</time>
        <h2>{photo.title}</h2>
      </div>
    </article>
  ))}
</section>

<div class="photo-lightbox" data-photo-lightbox hidden>
  <button class="photo-lightbox-close" type="button" data-photo-close aria-label="Cerrar vista previa de foto">
    &times;
  </button>
  <figure class="photo-lightbox-frame">
    <img data-photo-lightbox-image src="" alt="" />
    <figcaption>
      <time data-photo-lightbox-date></time>
      <span data-photo-lightbox-title></span>
    </figcaption>
  </figure>
</div>

<script>
  function initPhotoLightbox() {
    const lightbox = document.querySelector("[data-photo-lightbox]");
    // El overlay se reemplaza por un nodo nuevo en cada navegación: si ya está enlazado, se omite para evitar montarlo dos veces
    if (!(lightbox instanceof HTMLElement) || lightbox.dataset.bound) return;
    lightbox.dataset.bound = "1";

    const lightboxImage = lightbox.querySelector("[data-photo-lightbox-image]");
    const lightboxDate = lightbox.querySelector("[data-photo-lightbox-date]");
    const lightboxTitle = lightbox.querySelector("[data-photo-lightbox-title]");
    const closeButton = lightbox.querySelector("[data-photo-close]");
    const openButtons = document.querySelectorAll("[data-photo-open]");

    let savedScrollY = 0;

    const closeLightbox = () => {
      lightbox.hidden = true;
      document.documentElement.classList.remove("has-photo-lightbox");
      // Libera el body fijado y restaura la posición de scroll (ver regla has-photo-lightbox en CSS).
      // Desactiva temporalmente scroll-behavior:smooth, si no el scroll animaría desde arriba con posición incorrecta.
      document.body.style.top = "";
      const html = document.documentElement;
      const prevBehavior = html.style.scrollBehavior;
      html.style.scrollBehavior = "auto";
      window.scrollTo(0, savedScrollY);
      html.style.scrollBehavior = prevBehavior;
    };

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (
          !(lightboxImage instanceof HTMLImageElement) ||
          !(lightboxDate instanceof HTMLElement) ||
          !(lightboxTitle instanceof HTMLElement) ||
          !(button instanceof HTMLElement)
        ) {
          return;
        }

        lightboxImage.src = button.dataset.photoSrc ?? "";
        lightboxImage.alt = button.dataset.photoAlt ?? "";
        lightboxDate.textContent = button.dataset.photoDate ?? "";
        lightboxTitle.textContent = button.dataset.photoTitle ?? "";
        lightbox.hidden = false;
        // Fija el body para evitar que el scroll táctil móvil atraviese el overlay (guarda y bloquea la posición actual)
        savedScrollY = window.scrollY;
        document.body.style.top = `-${savedScrollY}px`;
        document.documentElement.classList.add("has-photo-lightbox");
        closeButton instanceof HTMLElement && closeButton.focus();
      });
    });

    closeButton?.addEventListener("click", closeLightbox);

    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) {
        closeLightbox();
      }
    });
  }

  // Cierre con Esc: se enlaza una sola vez en document, busca el overlay actual dinámicamente, evita fugas de listeners tras varias navegaciones
  if (!document.body.dataset.photoLightboxEsc) {
    document.body.dataset.photoLightboxEsc = "1";
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const lb = document.querySelector("[data-photo-lightbox]");
      if (lb instanceof HTMLElement && !lb.hidden) {
        lb.hidden = true;
        document.documentElement.classList.remove("has-photo-lightbox");
        // Igual que closeLightbox: libera el body fijado y restaura la posición de scroll
        const y = Math.abs(parseInt(document.body.style.top || "0", 10)) || 0;
        document.body.style.top = "";
        const html = document.documentElement;
        const prevBehavior = html.style.scrollBehavior;
        html.style.scrollBehavior = "auto";
        window.scrollTo(0, y);
        html.style.scrollBehavior = prevBehavior;
      }
    });
  }

  initPhotoLightbox();
  document.addEventListener("astro:page-load", initPhotoLightbox);
</script>
