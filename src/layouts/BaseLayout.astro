---
import { ClientRouter } from "astro:transitions";

const {
  title = "M♥M",
  description = "Un sitio web hecho a mano con Astro.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />
    <link
      rel="preload"
      href={`${import.meta.env.BASE_URL}fonts/laura-cursive.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{title}</title>
    <ClientRouter fallback="animate" />
    <script is:inline>
      // En la primera carga marca de inmediato el estado skeleton en <html>, evita mostrar texto antes de que la fuente esté lista
      if (!window.__pgFontsReady) {
        document.documentElement.classList.add("fonts-loading");

        const MAX_WAIT_MS = 6000;

        const finish = () => {
          if (window.__pgFontsReady) return;
          window.__pgFontsReady = true;
          const html = document.documentElement;
          html.classList.remove("fonts-loading");
          html.classList.add("fonts-loaded");
        };

        const timer = setTimeout(finish, MAX_WAIT_MS);

        // El skeleton pone el texto transparente, el navegador cree que no hay glifos visibles
        // que necesiten esa fuente, así que no la descarga, document.fonts.ready resuelve enseguida,
        // el skeleton se quita antes de tiempo, aparece la fuente de respaldo y luego la fuente web
        // carga y la reemplaza, provocando parpadeo de fuente (FOUT).
        // Aquí se fuerza la descarga de la fuente y se espera a que esté realmente lista.
        const fontsReady =
          document.fonts && typeof document.fonts.load === "function"
            ? document.fonts
                .load('1em "Laura Cursive"')
                .catch(() => {})
                .then(() => document.fonts.ready)
            : Promise.resolve();

        fontsReady.then(() => {
          clearTimeout(timer);
          // Doble rAF: asegura que el navegador ya pintó el primer frame con la nueva fuente antes de quitar el skeleton
          requestAnimationFrame(() => requestAnimationFrame(finish));
        });
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      if (!window.__ourStoryTransitionImagesReady) {
        window.__ourStoryTransitionImagesReady = true;

        const preloadImage = (src, signal) =>
          new Promise((resolve) => {
            if (!src || signal?.aborted) {
              resolve();
              return;
            }

            const image = new Image();
            const finish = () => resolve();

            image.onload = async () => {
              try {
                await image.decode?.();
              } catch {
                // Decoding is a polish step; failed decode should never block navigation.
              }
              finish();
            };
            image.onerror = finish;
            image.src = src;
          });

        const warmNextPageImages = async (event) => {
          const nextDocument = event.newDocument;
          const nextUrl = event.to;

          if (!(nextDocument instanceof Document) || !(nextUrl instanceof URL)) {
            return;
          }

          const images = Array.from(
            nextDocument.querySelectorAll(
              ".hero-photo img, .photo-tile img, .small-photo img, .generated-couple, .generated-flower, .bottom-park-art",
            ),
          )
            .map((image) => image.getAttribute("src"))
            .filter(Boolean)
            .slice(0, 8)
            .map((src) => new URL(src, nextUrl).href);

          if (!images.length) {
            return;
          }

          await Promise.race([
            Promise.allSettled(images.map((src) => preloadImage(src, event.signal))),
            new Promise((resolve) => setTimeout(resolve, 850)),
          ]);
        };

        document.addEventListener("astro:before-preparation", (event) => {
          const originalLoader = event.loader;

          if (typeof originalLoader !== "function") {
            return;
          }

          event.loader = async () => {
            await originalLoader();

            if (!event.defaultPrevented && !event.signal?.aborted) {
              await warmNextPageImages(event);
            }
          };
        });
      }
    </script>
  </body>
</html>
